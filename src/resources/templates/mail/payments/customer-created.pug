extends ../baseEmail

block content
  h1 Welcome to #{payload.appInfo.appName}, #{payload.user.firstname}!

  p We're excited to have you with us! Your account has been successfully created, and you're now a part of our community.

  p You can start exploring our platform and make the most of the features available to you. From browsing products to managing your purchases, everything is just a click away!

  p If you have any questions or need assistance, our support team is always ready to help.

  p
    a(href=payload.dashboardLink, class='btn btn-primary') Go to Your Dashboard

  small Thank you for joining #{payload.appInfo.appName}!
  br
  small
    b - #{payload.appInfo.appEmail}, #{payload.appInfo.appName}

extends ../baseEmail

block content
  p #{(payload.user)? `Hello ${payload.user.lastname}  ${payload.user.lastname} `: 'Hello'},

  p You've been invited to join "#{payload.invitation.team.name}" team.

  p You'll collaborate with members to help manage events. Click the below link to send your reaction:

  p
    a(href=payload.reactionLink) React To Invitation

  p NOTE: Make sure you're logged in to PLAVENTI with this email in order to accept/decline the invitation
  p
   small If you have any questions, feel free to send an email to #{payload.appEmail}.

  small Thank you!
  br
  p
   small
     b - #{payload.appEmail},
     br
     b The #{payload.companyName} Team
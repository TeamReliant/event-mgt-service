extends ../baseEmail

block content
  p Hello,
  p Great news! #{payload.invitation.user.lastname} #{payload.invitation.user.firstname} has accepted your invitation to join your team on #{payload.appInfo.appName}.

  p They are now part of your team and ready to collaborate on managing and organizing events. Feel free to reach out to them to get started.
  
  p
   small
    b Thank you for using #{payload.appInfo.appName}. We’re excited to see the great events you’ll create together!

  p
   small
    b Best Regards,
    br
    b The #{payload.appInfo.name} Team
doctype html
html
  head
    meta(name='viewport', content='width=device-width')
    meta(http-equiv='Content-Type', content='text/html; charset=UTF-8')
    title= subject

    include _style
  body
    table.body(role='presentation', border='0', cellpadding='0', cellspacing='0')
      tbody
        tr
          td
          td.container
            .content
              div(style='text-align: center; margin-bottom: -20px; background-color: #081B22;')
                img(src='https://cdn.prod.website-files.com/667b3fed88291c03fd439e23/667b466ec1853572ca1a7109_logo%20white%20font.png' style='width: 160px;')
              hr
              div(style='margin-top: 10px')
              // START CENTERED WHITE CONTAINER
              table.main(role='presentation')

                // START MAIN AREA
                tbody
                  tr
                    td.wrapper
                      table(role='presentation', border='0', cellpadding='0', cellspacing='0')
                        tbody
                          tr
                            td
                              // CONTENT
                              block content

              // START FOOTER
              .footer
                table(role='presentation', border='0', cellpadding='0', cellspacing='0')
                  tbody
                    tr
                      td.content-block
                        span.apple-link #{payload.appInfo.name} | Made with ♥ by #{payload.appInfo.companyName}
                        br
                        |  Don't like these emails? 
                        a(href='#') Unsubscribe
          //- td  

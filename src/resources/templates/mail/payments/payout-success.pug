extends ../baseEmail

block content
  h1 Congratulations, #{payload.user.firstname}!

  p Great news! Your recent payout of #{payload.payoutAmount} has been successfully processed and is on its way to your bank account. 

  p You can check the details of this payout and your payout history on your dashboard. If you have any questions or need assistance, feel free to reach out to our support team.

  p
    a(href=payload.dashboardLink, class='btn btn-primary') View Payout Details

  small Thank you for being a valued member of #{payload.appName}!
  br
  p.signature
    b The #{payload.appName} Team

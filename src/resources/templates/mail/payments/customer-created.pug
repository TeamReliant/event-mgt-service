extends ../baseEmail

block content
  h1 Welcome to #{payload.appInfo.appName}, #{payload.user.firstname}!,

  p We're excited to have you with us! A Stripe customer account has been successfully created for you, and you're now a part of our community.

  p You can start exploring our platform and make the most of the features available to you. From Creating an event to publishing it on our discovery page, everything is just a click away!

  p If you have any questions or need assistance, our support team is always ready to help.

  p
    a(href=payload.dashboardLink, class='btn btn-primary') Go to Your Dashboard

  small Thank you for joining #{payload.appName}!
  br
  small
    b - #{payload.appEmail}, #{payload.appName}

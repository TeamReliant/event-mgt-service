extends ../baseEmail

block content
  p #{(payload.user)? `Hello ${payload.user.lastname}  ${payload.user.lastname} `: 'Hello'},
  p You've been invited to join "#{payload.invitation.team.name}" team on #{payload.appInfo.name}.

  p As part of this team, you'll collaborate with others to help manage and organize events. Please take a moment to respond to the invitation by clicking one of the options below:

  p
    a(href=payload.reactionLink) React To Invitation
  
  p If you have any questions, feel free to reach out to our 24/7 contact centre immediately on #{payload.appInfo.phone}. Alternatively, send an email to #{payload.appInfo.email}.

  small Thank you!
  br
  small
    b - #{payload.appInfo.email}, #{payload.appInfo.name}
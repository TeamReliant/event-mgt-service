extends ../../baseEmail

block content
  p #{(payload.user.lastname)? `Hello ${payload.user.lastname}  ${payload.user.lastname} `: 'Hello'},
  p
    small You initiated a sign in request in your #{payload.appInfo.name} account on: #{payload.dateTime}.


  p Clink on the link below to sign in to your #{payload.appInfo.name} account.

  p
   a(href="https://frontendurl.com/magiclink-auth/#{payload.user.magicSignInToken}") Click here


  p If you did not initiate this log in, please call our 24/7 contact centre immediately on #{payload.appInfo.phone}. Alternatively, send an email to #{payload.appInfo.email}.

  small Thank you for choosing #{payload.appInfo.name}!.
  br
  small
    b - #{payload.appInfo.email}, #{payload.appInfo.name}
extends ../baseEmail

block content
  p Hello #{payload.invitation.team.admin.firstname},
  p #{payload.invitation.user.firstname} #{payload.invitation.user.lastname} has accepted your invitation to join your team:  #{payload.invitation.team.name}.

  p Date and time:  #{payload.dateTime}.

  p They are now part of your team and ready to collaborate on managing and organizing events. Feel free to reach out to them to get started.
  
  p
   small
    b Thank you for using #{payload.appInfo.name}. We’re excited to see the great events you’ll create together!

  p
   small
    b Best Regards,
    br
    b The #{payload.appInfo.name} Teampull pla